# Copy to .env and fill in. .env is git-ignored.
#
# ─── Choose the LLM back end ────────────────────────────────────────────────
# CODEFIX_LLM_PROVIDER = openrouter | openai | compatible
# Only the selected provider's key variable is ever read, so a key for another
# provider sitting in your environment can never be used or charged.
CODEFIX_LLM_PROVIDER=openrouter

# --- openrouter (default): one key for every model, free models available -----
# Create a personal key at https://openrouter.ai/settings/keys and SET A CREDIT
# LIMIT on it. Cost is reported exactly, from the provider's own figure.
OPENROUTER_API_KEY=sk-or-v1-...
CODEFIX_MODEL_PRIMARY=nex-agi/nex-n2.5-pro:free
CODEFIX_MODEL_SECONDARY=qwen/qwen3.8-27b:free
CODEFIX_MODEL_SPEC=nex-agi/nex-n2.5-pro:free
# Tried in order by OpenRouter when the primary is rate-limited or down.
CODEFIX_MODEL_FALLBACKS=qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free

# --- openai: your own OpenAI key -------------------------------------------
# CODEFIX_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# CODEFIX_MODEL_PRIMARY=gpt-5.2
# CODEFIX_MODEL_SECONDARY=gpt-5-mini
# CODEFIX_MODEL_SPEC=gpt-5.2
# OpenAI does not return the cost of a call. Set the model's prices (USD per 1M
# tokens) to have it reported; leave them out and the response says cost is unknown.
# CODEFIX_PRICE_INPUT_PER_M=1.75
# CODEFIX_PRICE_CACHED_INPUT_PER_M=0.175
# CODEFIX_PRICE_OUTPUT_PER_M=14.00

# --- compatible: any other OpenAI-compatible endpoint (Azure, vLLM, a proxy) --
# CODEFIX_LLM_PROVIDER=compatible
# CODEFIX_LLM_BASE_URL=http://localhost:1234/v1
# CODEFIX_LLM_API_KEY=...
# CODEFIX_MODEL_PRIMARY=your-model

# ─── Spend caps, enforced before every call ─────────────────────────────────
CODEFIX_MAX_COST_PER_REQUEST_USD=1.00
CODEFIX_MAX_COST_TOTAL_USD=5.00

# ─── Model behaviour ────────────────────────────────────────────────────────
# low keeps free reasoning models from spending their whole output budget on
# hidden reasoning; medium or high suits stronger paid models.
CODEFIX_REASONING_EFFORT=low

# ─── Sandbox: docker is required for real runs (grading parity) ─────────────
CODEFIX_SANDBOX=docker

# ─── Evaluation mode (optional) ─────────────────────────────────────────────
# Give every request at least this many seconds regardless of deadline_seconds,
# to measure correctness separately from speed on slow free models.
# Leave unset (0) for graded runs so the client's deadline is honoured.
# CODEFIX_BUDGET_FLOOR_S=1800
